# Frontend Environment Variables
VITE_API_URL=http://localhost:8000
VITE_TMDB_API_URL=https://api.themoviedb.org/3

# Backend Environment Variables
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0
BACKEND_RELOAD=true
TMDB_API_KEY=your_tmdb_api_key_here
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# MongoDB Environment Variables
# Connection settings
MONGO_HOST=localhost  # Use 'localhost' for local backend development, 'mongodb' for Docker
MONGO_PORT=27017
MONGO_DB=media_manager

# Application Database User (used by the application to connect)
MONGO_USER=app_user
MONGO_PASSWORD=app_password

# MongoDB Root User (used for administration)
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=change_me_in_production

# Mongo Express Environment Variables
ME_CONFIG_MONGODB_SERVER=mongodb
ME_CONFIG_MONGODB_PORT=27017
ME_CONFIG_MONGODB_ENABLE_ADMIN=true
ME_CONFIG_BASICAUTH_USERNAME=admin
ME_CONFIG_BASICAUTH_PASSWORD=change_me_in_production
